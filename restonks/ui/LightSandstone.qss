/* ===== Sandstone (Light) ===== */
* {
    font-family: "Inter", "Segoe UI", "Roboto", sans-serif;
    font-size: 14px;
}

QMainWindow, QDialog, QWidget {
    background-color: #faf6f0;
    color: #3a2f22;
}

QLabel {
    background: transparent;
}

/* --- Buttons --- */
QPushButton {
    background-color: #ffffff;
    border: 1px solid #e6dbc8;
    border-radius: 8px;
    padding: 7px 16px;
    color: #3a2f22;
}

QPushButton:hover {
    background-color: #fbf0dc;
    border-color: #d97706;
}

QPushButton:pressed {
    background-color: #f6e3c2;
}

QPushButton:disabled {
    color: #b5a891;
    background-color: #f2ede3;
    border-color: #ebe3d3;
}

/* --- Line Edits, Spin Boxes & Text Edits --- */
QLineEdit, QTextEdit, QPlainTextEdit, QSpinBox, QDoubleSpinBox {
    background-color: #ffffff;
    border: 1px solid #e6dbc8;
    border-radius: 6px;
    padding: 5px 8px;
    color: #3a2f22;
    selection-background-color: #d97706;
    selection-color: #ffffff;
}

QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus,
QSpinBox:focus, QDoubleSpinBox:focus {
    border: 1px solid #d97706;
}

QSpinBox::up-button, QDoubleSpinBox::up-button {
    subcontrol-origin: border;
    subcontrol-position: top right;
    width: 18px;
    border-left: 1px solid #e6dbc8;
    border-bottom: 1px solid #e6dbc8;
    border-top-right-radius: 6px;
    background-color: #f2ead9;
}

QSpinBox::down-button, QDoubleSpinBox::down-button {
    subcontrol-origin: border;
    subcontrol-position: bottom right;
    width: 18px;
    border-left: 1px solid #e6dbc8;
    border-top: 1px solid #e6dbc8;
    border-bottom-right-radius: 6px;
    background-color: #f2ead9;
}

QSpinBox::up-button:hover, QDoubleSpinBox::up-button:hover,
QSpinBox::down-button:hover, QDoubleSpinBox::down-button:hover {
    background-color: #d97706;
}

QSpinBox::up-arrow, QDoubleSpinBox::up-arrow {
    image: url(%ICONS_DIR%/spin-up-onlight.svg);
    width: 9px;
    height: 9px;
}

QSpinBox::up-arrow:disabled, QDoubleSpinBox::up-arrow:disabled {
    image: none;
}

QSpinBox::down-arrow, QDoubleSpinBox::down-arrow {
    image: url(%ICONS_DIR%/spin-down-onlight.svg);
    width: 9px;
    height: 9px;
}

QSpinBox::down-arrow:disabled, QDoubleSpinBox::down-arrow:disabled {
    image: none;
}

/* --- ComboBox --- */
QComboBox {
    border: 1px solid #e6dbc8;
    border-radius: 6px;
    padding: 5px 24px 5px 8px;
    background-color: #ffffff;
    color: #3a2f22;
}

QComboBox:hover {
    border-color: #d97706;
}

QComboBox::drop-down {
    border: none;
    width: 22px;
}

QComboBox QAbstractItemView {
    background-color: #ffffff;
    border: 1px solid #e6dbc8;
    color: #3a2f22;
    selection-background-color: #d97706;
    selection-color: #ffffff;
    outline: none;
}

/* --- Tables --- */
QTableWidget, QTableView {
    background-color: #ffffff;
    alternate-background-color: #faf3e6;
    gridline-color: #ebe3d3;
    border: 1px solid #e6dbc8;
    border-radius: 6px;
    color: #3a2f22;
    selection-background-color: #fbdba3;
    selection-color: #3a2f22;
}

QTableWidget::item, QTableView::item {
    padding: 4px;
}

QHeaderView::section {
    background-color: #f2ead9;
    color: #7a5b2c;
    padding: 6px;
    border: none;
    border-right: 1px solid #e6dbc8;
    border-bottom: 1px solid #e6dbc8;
    font-weight: 600;
}

QTableCornerButton::section {
    background-color: #f2ead9;
    border: none;
}

/* --- Scrollbars --- */
QScrollBar:vertical {
    border: none;
    background: #f2ead9;
    width: 12px;
    margin: 0px;
    border-radius: 6px;
}
QScrollBar::handle:vertical {
    background: #ddc9a3;
    border-radius: 6px;
    min-height: 24px;
}
QScrollBar::handle:vertical:hover {
    background: #d97706;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar:horizontal {
    border: none;
    background: #f2ead9;
    height: 12px;
    margin: 0px;
    border-radius: 6px;
}
QScrollBar::handle:horizontal {
    background: #ddc9a3;
    border-radius: 6px;
    min-width: 24px;
}
QScrollBar::handle:horizontal:hover {
    background: #d97706;
}
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0px;
}

/* --- Menus --- */
QMenuBar {
    background-color: #faf6f0;
    color: #3a2f22;
    border-bottom: 1px solid #ebe3d3;
}
QMenuBar::item {
    background: transparent;
    padding: 6px 10px;
}
QMenuBar::item:selected {
    background-color: #f6e3c2;
    border-radius: 4px;
}

QMenu {
    background-color: #ffffff;
    border: 1px solid #e6dbc8;
    padding: 4px;
}
QMenu::item {
    padding: 6px 24px;
    border-radius: 4px;
}
QMenu::item:selected {
    background-color: #d97706;
    color: #ffffff;
}
QMenu::separator {
    height: 1px;
    background: #ebe3d3;
    margin: 4px 8px;
}

/* --- Status Bar --- */
QStatusBar {
    background-color: #faf6f0;
    color: #7a6b53;
    border-top: 1px solid #ebe3d3;
}

/* --- Message Box --- */
QMessageBox {
    background-color: #faf6f0;
}

/* --- Tooltip --- */
QToolTip {
    background-color: #3a2f22;
    color: #faf6f0;
    border: 1px solid #d97706;
    padding: 4px 6px;
    border-radius: 4px;
}

/* --- CheckBox / RadioButton --- */
QCheckBox, QRadioButton {
    spacing: 8px;
    background: transparent;
}
