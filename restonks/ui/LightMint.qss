/* ===== Mint Breeze (Light) ===== */
* {
    font-family: "Inter", "Segoe UI", "Roboto", sans-serif;
    font-size: 14px;
}

QMainWindow, QDialog, QWidget {
    background-color: #f2f9f7;
    color: #1e2b27;
}

QLabel {
    background: transparent;
}

/* --- Buttons --- */
QPushButton {
    background-color: #ffffff;
    border: 1px solid #d3e8e1;
    border-radius: 8px;
    padding: 7px 16px;
    color: #1e2b27;
}

QPushButton:hover {
    background-color: #e6f7f1;
    border-color: #10b981;
}

QPushButton:pressed {
    background-color: #d1f0e4;
}

QPushButton:disabled {
    color: #a3b8b1;
    background-color: #edf5f2;
    border-color: #e0eee9;
}

/* --- Line Edits, Spin Boxes & Text Edits --- */
QLineEdit, QTextEdit, QPlainTextEdit, QSpinBox, QDoubleSpinBox {
    background-color: #ffffff;
    border: 1px solid #d3e8e1;
    border-radius: 6px;
    padding: 5px 8px;
    color: #1e2b27;
    selection-background-color: #10b981;
    selection-color: #ffffff;
}

QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus,
QSpinBox:focus, QDoubleSpinBox:focus {
    border: 1px solid #10b981;
}

QSpinBox::up-button, QDoubleSpinBox::up-button {
    subcontrol-origin: border;
    subcontrol-position: top right;
    width: 18px;
    border-left: 1px solid #d3e8e1;
    border-bottom: 1px solid #d3e8e1;
    border-top-right-radius: 6px;
    background-color: #e3f3ee;
}

QSpinBox::down-button, QDoubleSpinBox::down-button {
    subcontrol-origin: border;
    subcontrol-position: bottom right;
    width: 18px;
    border-left: 1px solid #d3e8e1;
    border-top: 1px solid #d3e8e1;
    border-bottom-right-radius: 6px;
    background-color: #e3f3ee;
}

QSpinBox::up-button:hover, QDoubleSpinBox::up-button:hover,
QSpinBox::down-button:hover, QDoubleSpinBox::down-button:hover {
    background-color: #10b981;
}

QSpinBox::up-arrow, QDoubleSpinBox::up-arrow {
    image: url(%ICONS_DIR%/spin-up-onlight.svg);
    width: 9px;
    height: 9px;
}

QSpinBox::up-arrow:disabled, QDoubleSpinBox::up-arrow:disabled {
    image: none;
}

QSpinBox::down-arrow, QDoubleSpinBox::down-arrow {
    image: url(%ICONS_DIR%/spin-down-onlight.svg);
    width: 9px;
    height: 9px;
}

QSpinBox::down-arrow:disabled, QDoubleSpinBox::down-arrow:disabled {
    image: none;
}

/* --- ComboBox --- */
QComboBox {
    border: 1px solid #d3e8e1;
    border-radius: 6px;
    padding: 5px 24px 5px 8px;
    background-color: #ffffff;
    color: #1e2b27;
}

QComboBox:hover {
    border-color: #10b981;
}

QComboBox::drop-down {
    border: none;
    width: 22px;
}

QComboBox QAbstractItemView {
    background-color: #ffffff;
    border: 1px solid #d3e8e1;
    color: #1e2b27;
    selection-background-color: #10b981;
    selection-color: #ffffff;
    outline: none;
}

/* --- Tables --- */
QTableWidget, QTableView {
    background-color: #ffffff;
    alternate-background-color: #eef8f5;
    gridline-color: #e0eee9;
    border: 1px solid #d3e8e1;
    border-radius: 6px;
    color: #1e2b27;
    selection-background-color: #b8ecda;
    selection-color: #1e2b27;
}

QTableWidget::item, QTableView::item {
    padding: 4px;
}

QHeaderView::section {
    background-color: #e3f3ee;
    color: #2f6b56;
    padding: 6px;
    border: none;
    border-right: 1px solid #d3e8e1;
    border-bottom: 1px solid #d3e8e1;
    font-weight: 600;
}

QTableCornerButton::section {
    background-color: #e3f3ee;
    border: none;
}

/* --- Scrollbars --- */
QScrollBar:vertical {
    border: none;
    background: #e3f3ee;
    width: 12px;
    margin: 0px;
    border-radius: 6px;
}
QScrollBar::handle:vertical {
    background: #a9d9c9;
    border-radius: 6px;
    min-height: 24px;
}
QScrollBar::handle:vertical:hover {
    background: #10b981;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar:horizontal {
    border: none;
    background: #e3f3ee;
    height: 12px;
    margin: 0px;
    border-radius: 6px;
}
QScrollBar::handle:horizontal {
    background: #a9d9c9;
    border-radius: 6px;
    min-width: 24px;
}
QScrollBar::handle:horizontal:hover {
    background: #10b981;
}
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0px;
}

/* --- Menus --- */
QMenuBar {
    background-color: #f2f9f7;
    color: #1e2b27;
    border-bottom: 1px solid #e0eee9;
}
QMenuBar::item {
    background: transparent;
    padding: 6px 10px;
}
QMenuBar::item:selected {
    background-color: #d1f0e4;
    border-radius: 4px;
}

QMenu {
    background-color: #ffffff;
    border: 1px solid #d3e8e1;
    padding: 4px;
}
QMenu::item {
    padding: 6px 24px;
    border-radius: 4px;
}
QMenu::item:selected {
    background-color: #10b981;
    color: #ffffff;
}
QMenu::separator {
    height: 1px;
    background: #e0eee9;
    margin: 4px 8px;
}

/* --- Status Bar --- */
QStatusBar {
    background-color: #f2f9f7;
    color: #4c675f;
    border-top: 1px solid #e0eee9;
}

/* --- Message Box --- */
QMessageBox {
    background-color: #f2f9f7;
}

/* --- Tooltip --- */
QToolTip {
    background-color: #1e2b27;
    color: #f2f9f7;
    border: 1px solid #10b981;
    padding: 4px 6px;
    border-radius: 4px;
}

/* --- CheckBox / RadioButton --- */
QCheckBox, QRadioButton {
    spacing: 8px;
    background: transparent;
}
