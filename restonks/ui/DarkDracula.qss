/* ===== Dracula (Dark) ===== */
* {
    font-family: "Inter", "Segoe UI", "Roboto", sans-serif;
    font-size: 14px;
}

QMainWindow, QDialog, QWidget {
    background-color: #282a36;
    color: #f8f8f2;
}

QLabel {
    background: transparent;
}

/* --- Buttons --- */
QPushButton {
    background-color: #343746;
    border: 1px solid #44475a;
    border-radius: 8px;
    padding: 7px 16px;
    color: #f8f8f2;
}

QPushButton:hover {
    background-color: #3d4053;
    border-color: #bd93f9;
}

QPushButton:pressed {
    background-color: #44475a;
}

QPushButton:disabled {
    color: #6a6f85;
    background-color: #2e303e;
    border-color: #383b4a;
}

/* --- Line Edits, Spin Boxes & Text Edits --- */
QLineEdit, QTextEdit, QPlainTextEdit, QSpinBox, QDoubleSpinBox {
    background-color: #21222c;
    border: 1px solid #44475a;
    border-radius: 6px;
    padding: 5px 8px;
    color: #f8f8f2;
    selection-background-color: #bd93f9;
    selection-color: #21222c;
}

QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus,
QSpinBox:focus, QDoubleSpinBox:focus {
    border: 1px solid #bd93f9;
}

QSpinBox::up-button, QDoubleSpinBox::up-button {
    subcontrol-origin: border;
    subcontrol-position: top right;
    width: 18px;
    border-left: 1px solid #44475a;
    border-bottom: 1px solid #44475a;
    border-top-right-radius: 6px;
    background-color: #343746;
}

QSpinBox::down-button, QDoubleSpinBox::down-button {
    subcontrol-origin: border;
    subcontrol-position: bottom right;
    width: 18px;
    border-left: 1px solid #44475a;
    border-top: 1px solid #44475a;
    border-bottom-right-radius: 6px;
    background-color: #343746;
}

QSpinBox::up-button:hover, QDoubleSpinBox::up-button:hover,
QSpinBox::down-button:hover, QDoubleSpinBox::down-button:hover {
    background-color: #bd93f9;
}

QSpinBox::up-arrow, QDoubleSpinBox::up-arrow {
    image: url(%ICONS_DIR%/spin-up-ondark.svg);
    width: 9px;
    height: 9px;
}

QSpinBox::up-arrow:disabled, QDoubleSpinBox::up-arrow:disabled {
    image: none;
}

QSpinBox::down-arrow, QDoubleSpinBox::down-arrow {
    image: url(%ICONS_DIR%/spin-down-ondark.svg);
    width: 9px;
    height: 9px;
}

QSpinBox::down-arrow:disabled, QDoubleSpinBox::down-arrow:disabled {
    image: none;
}

/* --- ComboBox --- */
QComboBox {
    border: 1px solid #44475a;
    border-radius: 6px;
    padding: 5px 24px 5px 8px;
    background-color: #21222c;
    color: #f8f8f2;
}

QComboBox:hover {
    border-color: #bd93f9;
}

QComboBox::drop-down {
    border: none;
    width: 22px;
}

QComboBox QAbstractItemView {
    background-color: #21222c;
    border: 1px solid #44475a;
    color: #f8f8f2;
    selection-background-color: #bd93f9;
    selection-color: #21222c;
    outline: none;
}

/* --- Tables --- */
QTableWidget, QTableView {
    background-color: #262834;
    alternate-background-color: #2b2d3a;
    gridline-color: #3a3d4d;
    border: 1px solid #44475a;
    border-radius: 6px;
    color: #f8f8f2;
    selection-background-color: #6272a4;
    selection-color: #ffffff;
}

QTableWidget::item, QTableView::item {
    padding: 4px;
}

QHeaderView::section {
    background-color: #343746;
    color: #bd93f9;
    padding: 6px;
    border: none;
    border-right: 1px solid #44475a;
    border-bottom: 1px solid #44475a;
    font-weight: 600;
}

QTableCornerButton::section {
    background-color: #343746;
    border: none;
}

/* --- Scrollbars --- */
QScrollBar:vertical {
    border: none;
    background: #21222c;
    width: 12px;
    margin: 0px;
    border-radius: 6px;
}
QScrollBar::handle:vertical {
    background: #44475a;
    border-radius: 6px;
    min-height: 24px;
}
QScrollBar::handle:vertical:hover {
    background: #bd93f9;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar:horizontal {
    border: none;
    background: #21222c;
    height: 12px;
    margin: 0px;
    border-radius: 6px;
}
QScrollBar::handle:horizontal {
    background: #44475a;
    border-radius: 6px;
    min-width: 24px;
}
QScrollBar::handle:horizontal:hover {
    background: #bd93f9;
}
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0px;
}

/* --- Menus --- */
QMenuBar {
    background-color: #282a36;
    color: #f8f8f2;
    border-bottom: 1px solid #383b4a;
}
QMenuBar::item {
    background: transparent;
    padding: 6px 10px;
}
QMenuBar::item:selected {
    background-color: #44475a;
    border-radius: 4px;
}

QMenu {
    background-color: #21222c;
    border: 1px solid #44475a;
    padding: 4px;
}
QMenu::item {
    padding: 6px 24px;
    border-radius: 4px;
}
QMenu::item:selected {
    background-color: #bd93f9;
    color: #21222c;
}
QMenu::separator {
    height: 1px;
    background: #44475a;
    margin: 4px 8px;
}

/* --- Status Bar --- */
QStatusBar {
    background-color: #282a36;
    color: #b3b6c4;
    border-top: 1px solid #383b4a;
}

/* --- Message Box --- */
QMessageBox {
    background-color: #282a36;
}

/* --- Tooltip --- */
QToolTip {
    background-color: #44475a;
    color: #f8f8f2;
    border: 1px solid #bd93f9;
    padding: 4px 6px;
    border-radius: 4px;
}

/* --- CheckBox / RadioButton --- */
QCheckBox, QRadioButton {
    spacing: 8px;
    background: transparent;
}
